{
  "name": "rn-size-check-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w rn-size-check",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/cli --noEmit",
    "dev": "npm run build && node packages/cli/bin/rn-size-check.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/yazl": "^2.4.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yazl": "^2.5.1"
  },
  "engines": {
    "node": ">=20"
  }
}
