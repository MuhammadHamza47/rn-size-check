{
  "name": "rn-size-check",
  "version": "0.1.2",
  "description": "Find out why your React Native app is big and how to shrink it.",
  "type": "module",
  "bin": {
    "rn-size-check": "bin/rn-size-check.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build && node -e \"for (const f of ['README.md', 'LICENSE']) require('fs').copyFileSync('../../' + f, f)\""
  },
  "keywords": [
    "react-native",
    "expo",
    "apk",
    "aab",
    "bundle-size",
    "app-size",
    "hermes",
    "rn-size-check",
    "apk-size",
    "android",
    "app-size-analyzer",
    "bundle-analyzer",
    "apk-analyzer",
    "r8",
    "proguard"
  ],
  "license": "MIT",
  "author": "Muhammad Hamza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuhammadHamza47/rn-size-check.git",
    "directory": "packages/cli"
  },
  "homepage": "https://rn-size-check-web.vercel.app",
  "bugs": "https://github.com/MuhammadHamza47/rn-size-check/issues",
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@rnsc/core": "0.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
